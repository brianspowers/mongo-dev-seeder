# ==============================================================================
# MongoDB Atlas Configuration (Source)
# ==============================================================================
# Your Atlas connection string.
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
ATLAS_URI=

# Optional: Specific Atlas database to dump. Leave blank to dump all databases.
ATLAS_DB_NAME=

# ==============================================================================
# Local MongoDB Docker Configuration (Target)
# ==============================================================================
# Docker image version for MongoDB (mongo:7.0, mongo:8.0, mongo:latest, etc.)
MONGO_IMAGE=mongo:7.0

# Name of the local Docker container
LOCAL_MONGO_CONTAINER_NAME=mongodb-local

# Port to expose on your host machine
LOCAL_MONGO_PORT=27017

# Optional authentication for local MongoDB.
# Leave blank for friction-free local development (no auth required).
LOCAL_MONGO_USERNAME=
LOCAL_MONGO_PASSWORD=

# Optional: Restore into a different database name locally.
# If blank, restores database(s) with the same name as dumped.
LOCAL_DB_NAME=

# ==============================================================================
# Optional Web UI (Mongo Express)
# ==============================================================================
MONGO_EXPRESS_PORT=8081
